# Postgres (docker-compose: postgres service)
DATABASE_URL="postgresql://borrow:borrow@localhost:5432/borrow_platform?schema=public"

# Redis (docker-compose: redis service) - cache, distributed locks, BullMQ job queue
REDIS_URL="redis://localhost:6379"

# RabbitMQ (docker-compose: rabbitmq service) - inter-module event bus
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Cloudinary (image + digital file storage, free tier) - fill in from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (transactional email) - fill in from your Resend dashboard
RESEND_API_KEY="re_your_resend_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

PORT=3001
